# ===========================================================================
# .gitignore — STM32CubeMX + Keil MDK-ARM on Windows
#
# Phase 0 rule: ignore build OUTPUT only. Never ignore anything a clean
# recompile cannot reproduce. Everything under Core/, Drivers/, MDK-ARM/
# project files, *.ioc and *.mxproject stays tracked.
# ===========================================================================

# --- Keil MDK: linker/browser output directory -----------------------------
# CubeMX sets the uVision output directory to the project-name folder, which
# contains spaces and is therefore NOT named Objects/. This is the single most
# important line: it also holds *.build_log.htm, which contains this machine's
# Arm license serial number.
MDK-ARM/Human Heart and Body Temperature Monitor/

# Generic Keil/ARM output-directory names, in case the layout ever changes.
Objects/
Listings/
*.build_log.htm
*.tra
*.iex
*.sbr
*.lnp
*.map
*.axf
*.htm
*.sct
*.dep
*.crf
*.o
*.obj
*.d
*.lst
MDK-ARM/**/*.lst

# --- Keil uVision per-user / transient state (regenerated by the IDE) ------
*.uvguix.*
*.uvgui.*
*.uvtmp
*.bak
*.tmp
*.orig
*.~,~
.#*

# --- CubeMX scratch ---------------------------------------------------------
# NOTE: *.ioc and .mxproject are deliberately TRACKED (they are the source of truth).
*.launch
*.log

# --- Debugger / flasher scratch --------------------------------------------
# RTE/ and DebugConfig/ are Keil project inputs and are deliberately TRACKED.

# --- CMake / generic build dirs (not used today, cheap to keep out) --------
build/
out/
Debug/
Release/
compile-output/

# --- Python / tooling scratch (host-side tooling arrives in later phases) --
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/

# --- Editors / OS -----------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
.DS_Store

# --- Qoder local workspace state -------------------------------------------
.qoder/

# --- Secrets: never commit these regardless of project ----------------------
*.key
*.pem
*.p12
*.pfx
*.crt
.env
.env.*
*_token*
*_secret*
credentials*
secrets*

# ===========================================================================
# Explicit un-ignores — safety net so a future broad pattern can never drop
# part of the project. Order matters: these come last.
# ===========================================================================
!*.ioc
!*.mxproject
!*.uvprojx
!*.uvoptx
!*.dbgconf
!*.s
!Core/**
!Drivers/**
!MDK-ARM/*.s
!MDK-ARM/RTE/**
!MDK-ARM/DebugConfig/**
!docs/**/*.htm
